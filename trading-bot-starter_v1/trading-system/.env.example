# Alpaca paper-trading credentials (free keys at alpaca.markets -> Paper Trading)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Long random string that TradingView must include in the webhook URL
WEBHOOK_SECRET=change-me-to-a-long-random-string

# true = log signals only, place no orders (start here)
DRY_RUN=true

# Risk limits (dollars)
MAX_NOTIONAL_PER_TRADE=1000
MAX_DAILY_LOSS=200
